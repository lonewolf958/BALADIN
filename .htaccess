# Baladin Zanzibar - Apache configuration (cPanel). Needs mod_rewrite; other modules are optional ("IfModule").
Options -Indexes
DirectoryIndex index.php

# ---- Force HTTPS and one hostname. Uncomment AFTER SSL works, and match your real domain. ----
# RewriteEngine On
# RewriteCond %{HTTPS} off [OR]
# RewriteCond %{HTTP_HOST} !^www\.baladinzanzibar\.com$ [NC]
# RewriteRule ^ https://www.baladinzanzibar.com%{REQUEST_URI} [L,R=301]

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# Serve real files directly (CSS, JS, images, video, robots.txt)
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule ^ - [L]

# Everything else (clean URLs, /sitemap.xml, 404s) goes to the PHP front controller.
# Real directories are NOT served directly, so /config/ etc. cannot be browsed.
RewriteRule ^ index.php [QSA,L]
</IfModule>

# Never expose documentation or hidden files
<FilesMatch "(^\.|\.md$)">
  Require all denied
</FilesMatch>
<FilesMatch "^\.htaccess$">
  Require all denied
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
  # The site loads nothing from other domains, so a strict CSP is safe. wa.me / mailto: are plain links.
  Header always set Content-Security-Policy "default-src 'self'; img-src 'self' data:; media-src 'self'; style-src 'self'; script-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'"
  # Enable only once HTTPS is confirmed working (it tells browsers to always use HTTPS):
  # Header always set Strict-Transport-Security "max-age=31536000"
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType text/css "access plus 7 days"
  ExpiresByType application/javascript "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 30 days"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 30 days"
  ExpiresByType image/webp "access plus 30 days"
  ExpiresByType video/mp4 "access plus 7 days"
  ExpiresByType video/webm "access plus 7 days"
</IfModule>
